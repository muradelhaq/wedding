{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "routes": [
        {
            "src": "/(build|css|js|images|fonts|audio|favicon.ico|robots.txt)(.*)",
            "dest": "/public/$1$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "LOG_CHANNEL": "stderr",
        "CACHE_STORE": "database",
        "SESSION_DRIVER": "database",
        "QUEUE_CONNECTION": "database"
    }
}
